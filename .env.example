# ==============================================================================
# ForeTrade Environment Configuration
# Copy this file to .env and customize values for your deployment or local setup.
# ==============================================================================

# --- DATABASE & PERSISTENCE ---
# Default is the local deterministic SQLite database.
# For PostgreSQL in staging/production: postgresql+psycopg://user:password@localhost:5432/foretrade
DATABASE_URL=sqlite:///foretrade.db

# --- API & NETWORKING ---
API_PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- SESSION & SECURITY ---
SESSION_COOKIE_NAME=foretrade_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# --- GOOGLE OAUTH 2.0 CREDENTIALS ---
# 1. Visit Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth 2.0 Client ID" (Web application).
# 3. Add Authorized Redirect URI: http://localhost:8000/api/v1/auth/google/callback
#    (And http://localhost:3000/api/v1/auth/google/callback if proxied)
# 4. Paste your Client ID and Client Secret below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- DATA STORAGE & UPLOADS ---
UPLOAD_DIR=.uploads
MAX_UPLOAD_BYTES=26214400

# --- AI & COPILOT ENGINES (GEMINI 2.0 FLASH / OPENROUTER) ---
# Primary Engine: Google Gemini (Fast, accurate, generous free tier)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Fallback Engine: OpenRouter (NVIDIA Nemotron 3 Ultra / Llama 3.3)
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- B2B CONTACT ENRICHMENT (HUNTER.IO & APOLLO.IO) ---
# Primary Engine: Hunter.io (25 free searches/month, zero credit card required)
# Get your free developer API key at: https://hunter.io/api-keys
HUNTER_API_KEY=

# Secondary Provider: Apollo.io
# Get API key at: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

